# The framework's per-project directory holds runtime state (progress ledger,
# worktrees, role-run logs, notes) beside the two tracked configuration files.
# This repo dogfoods the framework, so its own profile and config are tracked.
.delivery-team/*
!.delivery-team/profile.md
!.delivery-team/config.toml

# Python tooling caches
__pycache__/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
